# Local bind host. Defaults to 127.0.0.1 for local desktop safety.
# Set to 0.0.0.0 only inside containerized/cloud preview environments.
HOST="127.0.0.1"

# HTTP listen port for local dev/preview server.
PORT="3000"

# Optional admin password protecting /admin/api/* endpoints.
# When unset on localhost, only direct loopback requests (non-proxied) are allowed.
CODEARTS_ADMIN_PASSWORD=""

# Optional directory for persisting state & switch config snapshots.
# Defaults to ./data when unset.
CODEARTS_SWITCH_DATA_DIR=""

# Optional: Bridge /admin/api/* and /v1/* to a locally running Go CodeArts2API instance (loopback only).
# Example: CODEARTS_GO_UPSTREAM="http://127.0.0.1:10087"
CODEARTS_GO_UPSTREAM=""

