{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeArts-Switch",
  "version": "1.0.1",
  "identifier": "com.codearts.switch",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "码道 Switch — CodeArts 智能体网关",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/codearts-gateway"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
